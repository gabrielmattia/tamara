/* ===================================================== */
/* === EDUMY: Painel customizado Uniguaçu ============== */
/* === Versão refatorada com design tokens (v2.0)    === */
/* ===================================================== */

/* ===================================================== */
/* === SEÇÃO 0: DESIGN TOKENS ========================== */
/* === Altere as variáveis aqui para mudar o sistema === */
/* === visual inteiro de uma só vez                  === */
/* ===================================================== */

:root {

    /* === CORES DE FUNDO ============================== */
    --u-bg-page:           #f5f7fa;  /* Fundo principal (cinza azulado sutil) */
    --u-bg-card:           #ffffff;  /* Cards de destaque (sidebar e cursos) */
    --u-bg-card-inset:     #f5f7fa;  /* Cards "escavados" (cursos recentes internos) */
    --u-bg-card-hover:     #fafbfd;  /* Hover sutil em cards */
    --u-bg-card-inset-hover: #eaeef5; /* Hover em cards escavados */
    --u-bg-input:          #ffffff;  /* Campos de formulário */

    /* === CORES DE TEXTO ============================== */
    --u-text-primary:      #1f2937;  /* Texto principal */
    --u-text-secondary:    #6b7280;  /* Texto secundário */
    --u-text-tertiary:     #9ca3af;  /* Labels, hints */
    --u-text-on-brand:     #ffffff;  /* Texto sobre azul/dourado */

    /* === CORES DE BORDA ============================== */
    --u-border-subtle:     #e8edf3;  /* Borda padrão (muito sutil) */
    --u-border-medium:     #dde3ec;  /* Borda padrão visível */
    --u-border-strong:     #c5cee0;  /* Borda hover/destaque */

    /* === CORES DE MARCA UNIGUAÇU ===================== */
    --u-brand-primary:        #1a4d8c;  /* Azul institucional */
    --u-brand-primary-dark:   #143a6b;  /* Azul hover/ativo */
    --u-brand-accent:         #c9a961;  /* Dourado */
    --u-brand-accent-dark:    #a88a47;  /* Dourado hover/ativo */

    /* RGB para uso com rgba() em hovers e overlays */
    --u-brand-primary-rgb:    26, 77, 140;
    --u-brand-accent-rgb:     201, 169, 97;

    /* === SOMBRAS ===================================== */
    --u-shadow-subtle:     0 1px 2px rgba(15, 23, 42, 0.04);
    --u-shadow-medium:     0 2px 4px rgba(15, 23, 42, 0.06);

    /* === BORDAS ARREDONDADAS ========================= */
    --u-radius-sm:         6px;
    --u-radius-md:         8px;
    --u-radius-lg:         12px;

    /* === TRANSIÇÕES ================================== */
    --u-transition-fast:   all 0.15s ease;
    --u-transition-base:   all 0.2s ease;
    --u-transition-slow:   all 0.3s ease;

    /* === BARRA DE PROGRESSO ========================== */
    --u-progress-bg:       #e8edf3;
    --u-progress-fill:     var(--u-brand-accent);
}

/* ===================================================== */
/* === SEÇÃO 1: RESET E LIMPEZA ======================== */
/* ===================================================== */

/* 1.1 Esconde cards de Mensagens/Perfil/Configurações */
.our-dashbord .col-xl-12 > .row:has(.ff_one) {
    display: none !important;
}

/* 1.2 Esconde navegação "Página inicial" duplicada */
.our-dashbord .primary-navigation {
    display: none !important;
}

/* 1.3 Reset amplo: containers transparentes por padrão */
.our-dashbord .card,
.our-dashbord .card-body,
.our-dashbord .card-block,
.our-dashbord .ccnBlockContent,
.our-dashbord .block,
.our-dashbord aside .block,
.our-dashbord .block_calendar_month,
.our-dashbord .block_recentlyaccessedcourses,
.our-dashbord .block_myoverview,
.our-dashbord #region-main,
.our-dashbord #region-main-box,
.our-dashbord [role="main"],
.our-dashbord .main-inner,
.our-dashbord .my_course_content_header,
.our-dashbord .courses_list_heading,
.our-dashbord .instructor_search_result,
.our-dashbord .my_course_content,
.our-dashbord .my_course_content_list,
.our-dashbord [data-region="card-deck"],
.our-dashbord [data-region="view-content"],
.our-dashbord .container-fluid,
.our-dashbord .my_course_content_list .details,
.our-dashbord .my_course_content_list .mc_content,
.our-dashbord .my_course_content_list .ccn_mc_content_header,
.our-dashbord .my_course_content_list .ccn_mc_content_header_details {
    background: transparent !important;
    background-color: transparent !important;
    border: none !important;
    box-shadow: none !important;
}

/* 1.4 Limpa padding/margin extras dos containers da sidebar */
.our-dashbord .col-lg-4,
.our-dashbord .col-xl-4,
.our-dashbord .ccn-sidebar-region {
    padding-top: 0 !important;
    margin-top: 0 !important;
}

/* ===================================================== */
/* === SEÇÃO 2: FUNDO E TIPOGRAFIA ===================== */
/* ===================================================== */

/* 2.1 Fundo principal da página */
.our-dashbord,
.dashbord,
#page-my-index,
body#page-my-index {
    background-color: var(--u-bg-page) !important;
}

/* 2.2 Cabeçalho "Painel" — flat, sem fundo cinza */
.our-dashbord .page-context-header,
.our-dashbord .page-header-headings,
.our-dashbord #page-header,
.our-dashbord .page-header,
body#page-my-index #page-header,
body#page-my-index .page-context-header,
body.path-my .page-context-header,
body.path-my #page-header {
    background: transparent !important;
    background-color: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    margin-bottom: 16px !important;
}

/* 2.3 Título principal "Painel" — destaque com underline dourado */
.our-dashbord .page-context-header h1,
.our-dashbord .page-header-headings h1,
.our-dashbord #page-header h1 {
    font-size: 26px !important;
    font-weight: 600 !important;
    color: var(--u-brand-primary) !important;
    margin: 0 !important;
    padding-bottom: 12px !important;
    position: relative !important;
    display: inline-block !important;
}

.our-dashbord .page-context-header h1::after,
.our-dashbord .page-header-headings h1::after,
.our-dashbord #page-header h1::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 40px;
    height: 3px;
    background: var(--u-brand-accent);
    border-radius: 2px;
}

/* ===================================================== */
/* === SEÇÃO 3: BOTÕES E INPUTS ======================== */
/* ===================================================== */

/* 3.1 Botões secundários (edição, filtros, calendário) */
.our-dashbord #page-heading-button button,
.our-dashbord #page-heading-button input[type="submit"],
.our-dashbord .my_course_content_header .btn,
.our-dashbord .my_course_content_header button,
.our-dashbord .my_course_content_header .dropdown-toggle,
.our-dashbord .courses_list_heading .btn,
.our-dashbord .courses_list_heading button,
.our-dashbord .courses_list_heading .dropdown-toggle,
.our-dashbord .block_calendar_month .btn-primary,
.our-dashbord .block_calendar_month a.btn,
.our-dashbord .block_calendar_month button.btn,
.our-dashbord .block_calendar_month input[type="submit"] {
    padding: 8px 18px !important;
    font-size: 13px !important;
    font-weight: 400 !important;
    border-radius: var(--u-radius-md) !important;
    background: var(--u-bg-input) !important;
    color: var(--u-text-secondary) !important;
    border: 1px solid var(--u-border-medium) !important;
    box-shadow: var(--u-shadow-subtle) !important;
    transition: var(--u-transition-base) !important;
    height: auto !important;
    line-height: 1.4 !important;
    letter-spacing: 0.2px !important;
    text-shadow: none !important;
    text-decoration: none !important;
}

.our-dashbord #page-heading-button button:hover,
.our-dashbord #page-heading-button input[type="submit"]:hover,
.our-dashbord .my_course_content_header .btn:hover,
.our-dashbord .my_course_content_header button:hover,
.our-dashbord .my_course_content_header .dropdown-toggle:hover,
.our-dashbord .courses_list_heading .btn:hover,
.our-dashbord .courses_list_heading button:hover,
.our-dashbord .courses_list_heading .dropdown-toggle:hover,
.our-dashbord .block_calendar_month .btn-primary:hover,
.our-dashbord .block_calendar_month a.btn:hover,
.our-dashbord .block_calendar_month button.btn:hover {
    background: var(--u-bg-card-hover) !important;
    border-color: var(--u-brand-accent) !important;
    color: var(--u-brand-primary) !important;
    box-shadow: var(--u-shadow-medium) !important;
}

.our-dashbord #page-heading-button button:active,
.our-dashbord .my_course_content_header .btn:active,
.our-dashbord .courses_list_heading .btn:active {
    transform: translateY(1px);
    box-shadow: var(--u-shadow-subtle) !important;
}

/* 3.2 Espaçamento entre botões de edição */
.our-dashbord #page-heading-button .singlebutton {
    margin-right: 8px !important;
}

.our-dashbord #page-heading-button .singlebutton:last-child {
    margin-right: 0 !important;
}

/* 3.3 Setinha do dropdown */
.our-dashbord .my_course_content_header .dropdown-toggle::after,
.our-dashbord .courses_list_heading .dropdown-toggle::after {
    margin-left: 8px !important;
    border-top-color: currentColor !important;
}

/* 3.4 Campo de busca e inputs */
.our-dashbord .my_course_content_header input[type="text"],
.our-dashbord .my_course_content_header input[type="search"],
.our-dashbord .my_course_content_header .form-control {
    padding: 8px 14px !important;
    font-size: 13px !important;
    border-radius: var(--u-radius-md) !important;
    background: var(--u-bg-input) !important;
    border: 1px solid var(--u-border-medium) !important;
    box-shadow: var(--u-shadow-subtle) !important;
    transition: var(--u-transition-base) !important;
    color: var(--u-text-primary) !important;
}

.our-dashbord .my_course_content_header input[type="text"]:focus,
.our-dashbord .my_course_content_header input[type="search"]:focus,
.our-dashbord .my_course_content_header .form-control:focus {
    border-color: var(--u-brand-accent) !important;
    box-shadow: 0 0 0 3px rgba(var(--u-brand-accent-rgb), 0.15) !important;
    outline: none !important;
}

/* ===================================================== */
/* === SEÇÃO 4: CARROSSEL DE BOAS-VINDAS =============== */
/* ===================================================== */

/* 4.1 Container do carrossel */
.our-dashbord #carouselBanners {
    border-radius: var(--u-radius-lg);
    overflow: hidden;
    box-shadow: var(--u-shadow-medium);
    margin-bottom: 20px;
    position: relative;
}

/* 4.2 Estrutura: altura fixa em todos os elementos */
.our-dashbord #carouselBanners,
.our-dashbord #carouselBanners .carousel-inner,
.our-dashbord #carouselBanners .carousel-item,
.our-dashbord #carouselBanners .banner-link {
    height: 450px !important;
    overflow: hidden !important;
    position: relative !important;
}

/* 4.3 Imagens cobrem o container, cortam o excesso */
.our-dashbord #carouselBanners .carousel-item img,
.our-dashbord #carouselBanners .banner-link img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center center !important;
    display: block !important;
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    pointer-events: none;
}

/* 4.4 SVGs (caso voltem a ser usados) */
.our-dashbord #carouselBanners .banner-link svg {
    position: absolute !important;
    top: 50% !important;
    left: 50% !important;
    transform: translate(-50%, -50%) !important;
    width: auto !important;
    height: 450px !important;
    min-width: 100% !important;
    max-width: none !important;
    display: block !important;
    pointer-events: none;
}

/* 4.5 Link clicável ao redor da imagem */
.our-dashbord #carouselBanners .banner-link {
    display: block;
    cursor: pointer;
    text-decoration: none;
}

.our-dashbord #carouselBanners .banner-link::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0);
    transition: var(--u-transition-slow);
    pointer-events: none;
}

.our-dashbord #carouselBanners .banner-link:hover::after {
    background: rgba(0, 0, 0, 0.1);
}

/* 4.6 Indicadores (bolinhas) */
.our-dashbord #carouselBanners .carousel-indicators {
    position: absolute !important;
    bottom: 15px !important;
    z-index: 20 !important;
    display: flex !important;
    justify-content: center !important;
    margin-bottom: 0 !important;
}

.our-dashbord #carouselBanners .carousel-indicators li {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.6);
    border: 2px solid rgba(255, 255, 255, 0.8);
    margin: 0 4px;
    transition: var(--u-transition-slow);
    cursor: pointer;
}

.our-dashbord #carouselBanners .carousel-indicators li.active {
    background-color: #ffffff;
    transform: scale(1.2);
}

/* 4.7 Setas laterais (aparecem só no hover) */
.our-dashbord #carouselBanners .carousel-control-prev,
.our-dashbord #carouselBanners .carousel-control-next {
    width: 50px;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 20;
}

.our-dashbord #carouselBanners:hover .carousel-control-prev,
.our-dashbord #carouselBanners:hover .carousel-control-next {
    opacity: 0.9;
}

.our-dashbord #carouselBanners .carousel-control-prev-icon,
.our-dashbord #carouselBanners .carousel-control-next-icon {
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 50%;
    width: 36px;
    height: 36px;
    background-size: 50%;
}

/* ===================================================== */
/* === SEÇÃO 5: CARDS DE CURSO (LISTAGEM CENTRAL) ====== */
/* ===================================================== */

/* 5.1 Bloquinhos individuais para cada curso */
.our-dashbord .my_course_content_list .mc_content_list,
.our-dashbord [data-region="card-deck"] > [data-region="course-content"] {
    background: var(--u-bg-card) !important;
    border: 0.5px solid var(--u-border-medium) !important;
    border-radius: var(--u-radius-lg) !important;
    box-shadow: none !important;
    padding: 16px !important;
    margin-bottom: 12px !important;
    transition: var(--u-transition-base) !important;
}

.our-dashbord .my_course_content_list .mc_content_list:hover,
.our-dashbord [data-region="card-deck"] > [data-region="course-content"]:hover {
    background: var(--u-bg-card-hover) !important;
    border-color: var(--u-border-strong) !important;
}

.our-dashbord .my_course_content_list .mc_content_list:last-child,
.our-dashbord [data-region="card-deck"] > [data-region="course-content"]:last-child {
    margin-bottom: 0 !important;
}

/* 5.2 Reset de separadores antigos entre cards */
.our-dashbord .my_course_content_list .mc_content_list + .mc_content_list,
.our-dashbord [data-region="card-deck"] > [data-region="course-content"] + [data-region="course-content"] {
    border-top: 0.5px solid var(--u-border-medium) !important;
    padding-top: 16px !important;
    margin-top: 0 !important;
}

/* ===================================================== */
/* === SEÇÃO 6: BANNERS CLICÁVEIS DOS CURSOS GRANDES === */
/* === (NÃO se aplica aos cursos recentes — esses    === */
/* === têm tratamento próprio na Seção 7)            === */
/* ===================================================== */

/* 6.1 Container da imagem clicável */
.our-dashbord .block_myoverview .thumb,
.our-dashbord .my_course_content .thumb {
    position: relative !important;
    cursor: pointer !important;
    overflow: hidden !important;
    border-radius: var(--u-radius-md) !important;
}

/* 6.2 Overlay cobre toda a imagem */
.our-dashbord .block_myoverview .thumb .overlay,
.our-dashbord .my_course_content .thumb .overlay {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    width: 100% !important;
    height: 100% !important;
    background: transparent !important;
    opacity: 1 !important;
    visibility: visible !important;
    display: block !important;
    transform: none !important;
}

/* 6.3 Limpa estilos do overlay original do tema */
.our-dashbord .block_myoverview .thumb .overlay ul,
.our-dashbord .my_course_content .thumb .overlay ul,
.our-dashbord .block_myoverview .thumb .overlay li,
.our-dashbord .my_course_content .thumb .overlay li {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    margin: 0 !important;
    list-style: none !important;
    display: block !important;
    width: 100% !important;
    height: 100% !important;
}

/* 6.4 Link "View" cobre toda a imagem (clicável invisível) */
.our-dashbord .block_myoverview .thumb .overlay .mcc_view,
.our-dashbord .my_course_content .thumb .overlay .mcc_view {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    display: block !important;
    font-size: 0 !important;
    line-height: 0 !important;
    color: transparent !important;
    text-decoration: none !important;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    margin: 0 !important;
    border-radius: 0 !important;
    transform: none !important;
    opacity: 1 !important;
    visibility: visible !important;
    z-index: 5 !important;
}

.our-dashbord .block_myoverview .thumb .overlay .mcc_view:hover,
.our-dashbord .my_course_content .thumb .overlay .mcc_view:hover,
.our-dashbord .block_myoverview .thumb .overlay .mcc_view:focus,
.our-dashbord .my_course_content .thumb .overlay .mcc_view:focus {
    background: transparent !important;
    color: transparent !important;
    box-shadow: none !important;
    border: none !important;
    transform: none !important;
}

/* 6.5 Seta circular branca decorativa (canto inferior direito) */
.our-dashbord .block_myoverview .thumb::after,
.our-dashbord .my_course_content .thumb::after {
    content: "→";
    position: absolute;
    bottom: 12px;
    right: 12px;
    width: 40px;
    height: 40px;
    background: var(--u-bg-card);
    color: var(--u-brand-primary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    font-weight: bold;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
    z-index: 1;
    transition: var(--u-transition-base);
    pointer-events: none;
}

.our-dashbord .block_myoverview .thumb:hover::after,
.our-dashbord .my_course_content .thumb:hover::after {
    background: var(--u-brand-primary);
    color: var(--u-text-on-brand);
    transform: scale(1.1);
    box-shadow: 0 4px 12px rgba(var(--u-brand-primary-rgb), 0.4);
}

/* 6.6 Escurecimento sutil da imagem no hover */
.our-dashbord .block_myoverview .thumb::before,
.our-dashbord .my_course_content .thumb::before {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0);
    transition: var(--u-transition-base);
    z-index: 1;
    pointer-events: none;
}

.our-dashbord .block_myoverview .thumb:hover::before,
.our-dashbord .my_course_content .thumb:hover::before {
    background: rgba(0, 0, 0, 0.15);
}

/* ===================================================== */
/* === SEÇÃO 7: CURSOS ACESSADOS RECENTEMENTE ========== */
/* === (Lista compacta horizontal na sidebar)        === */
/* ===================================================== */

/* 7.1 Wrapper do bloco — card branco com borda */
.our-dashbord aside .block_recentlyaccessedcourses .ccnBlockContent,
.our-dashbord .ccn-sidebar-region .block_recentlyaccessedcourses .ccnBlockContent {
    background: var(--u-bg-card) !important;
    border: 0.5px solid var(--u-border-medium) !important;
    box-shadow: none !important;
    border-radius: var(--u-radius-lg) !important;
    padding: 16px !important;
}

/* 7.2 Esconde setas do carrossel original */
.our-dashbord .block_recentlyaccessedcourses .my_course_content_header .col-xl-4 {
    display: none !important;
}

.our-dashbord .block_recentlyaccessedcourses .my_course_content_header .col-xl-8 {
    flex: 0 0 100% !important;
    max-width: 100% !important;
}

/* 7.3 Esconde placeholder de loading */
.our-dashbord .block_recentlyaccessedcourses [data-region="loading-placeholder"] {
    display: none !important;
}

/* 7.4 Container de cards: coluna vertical com gap */
.our-dashbord .block_recentlyaccessedcourses .my_course_content_list,
.our-dashbord .block_recentlyaccessedcourses [data-region="card-deck"] {
    display: flex !important;
    flex-direction: column !important;
    gap: 8px !important;
    justify-content: flex-start !important;
    width: 100% !important;
}

/* 7.5 Cards individuais — linha horizontal compacta com fundo "escavado" */
.our-dashbord .block_recentlyaccessedcourses .mc_content_list,
.our-dashbord .block_recentlyaccessedcourses [data-region="course-content"] {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 12px !important;
    padding: 10px 50px 10px 10px !important;
    background: var(--u-bg-card-inset) !important;
    border: 0.5px solid var(--u-border-subtle) !important;
    border-left: 3px solid var(--u-brand-accent) !important;
    border-radius: var(--u-radius-md) !important;
    box-shadow: none !important;
    transition: var(--u-transition-base) !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    position: relative !important;
    min-height: 80px !important;
    box-sizing: border-box !important;
}

.our-dashbord .block_recentlyaccessedcourses .mc_content_list:hover {
    background: var(--u-bg-card-inset-hover) !important;
    border-color: var(--u-border-strong) !important;
    border-left-color: var(--u-brand-primary) !important;
}

/* 7.6 Mostra apenas os 4 cards mais recentes */
.our-dashbord .block_recentlyaccessedcourses .mc_content_list:nth-child(n+5) {
    display: none !important;
}

/* 7.7 Bloqueio de separador entre cards (proteção) */
.our-dashbord .block_recentlyaccessedcourses .mc_content_list + .mc_content_list,
.our-dashbord .block_recentlyaccessedcourses [data-region="course-content"] + [data-region="course-content"] {
    border-top: none !important;
    padding-top: 10px !important;
    margin-top: 0 !important;
}

/* 7.8 Thumb 60x60 — blindado contra outras regras */
.our-dashbord .block_recentlyaccessedcourses .mc_content_list .thumb,
.our-dashbord .block_recentlyaccessedcourses [data-region="course-content"] .thumb,
body .our-dashbord .block_recentlyaccessedcourses .mc_content_list .thumb {
    flex: 0 0 60px !important;
    width: 60px !important;

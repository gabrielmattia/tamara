/* ============================================
   RESPONSIVIDADE MOBILE - Versão consolidada v6
   ============================================ */

@media (max-width: 768px) {

    /* PADDING LATERAL DA PÁGINA - respiro nas bordas */
    html body[class*="format-"] {
        padding-left: 8px !important;
        padding-right: 8px !important;
        box-sizing: border-box !important;
    }

    html body[class*="format-"] #page,
    html body[class*="format-"] #page-content,
    html body[class*="format-"] #page-wrapper,
    html body[class*="format-"] #page-wrapper > .container-fluid,
    html body[class*="format-"] #region-main,
    html body[class*="format-"] #region-main-box {
        padding-left: 0 !important;
        padding-right: 0 !important;
    }

    /* ============================================
       CARDS DE CONTEÚDO (jornada, clinic day, etc.)
       Empilha em coluna única QUALQUER card grid de 2 colunas
       inserido como conteúdo de curso (rótulo, página, recurso HTML)
       ============================================ */

    html body[class*="format-"] div[style*="display: grid"][style*="grid-template-columns"] {
        display: flex !important;
        flex-direction: column !important;
        grid-template-columns: 1fr !important;
        gap: 16px !important;
    }

    html body[class*="format-"] div[style*="grid-template-columns"] > div {
        width: 100% !important;
        max-width: 100% !important;
    }

    html body[class*="format-"] div[style*="grid-template-columns"] > div[style*="background"] {
        border-left: none !important;
        border-top: 1px solid var(--borda-padrao) !important;
        margin-top: 0 !important;
        padding: 16px !important;
    }

    html body[class*="format-"] div[style*="padding: 36px"],
    html body[class*="format-"] div[style*="padding:36px"] {
        padding: 16px !important;
    }

    html body[class*="format-"] div[style*="width: 1px"][style*="background"] {
        display: none !important;
    }

    /* ATIVIDADES - Layout horizontal mobile */
    html body.format-tiles .activity-basis > div.flex-column,
    html body.format-tiles .activity-basis > div.d-flex.flex-column {
        flex-direction: row !important;
        align-items: center !important;
    }

    html body.format-tiles .activity-basis {
        align-items: center !important;
        flex-wrap: nowrap !important;
        gap: 8px !important;
    }

    html body.format-tiles .activity-basis .activity-icon,
    html body.format-tiles .activity-basis .activityiconcontainer {
        align-self: center !important;
        margin-right: 12px !important;
        margin-bottom: 0 !important;
        flex-shrink: 0 !important;
    }

    html body.format-tiles .activity-basis .d-flex.flex-column,
    html body.format-tiles .activity-basis .flex-md-row {
        flex: 1 1 auto !important;
        min-width: 0 !important;
    }

    html body.format-tiles .activity-name-area {
        align-self: center !important;
        text-align: left !important;
        flex: 1 !important;
        min-width: 0 !important;
        word-wrap: break-word !important;
        overflow-wrap: break-word !important;
        white-space: normal !important;
    }

    html body.format-tiles .activitytitle,
    html body.format-tiles .activityname {
        text-align: left !important;
    }

    html body.format-tiles .activity-info,
    html body.format-tiles .activity-info.mt-1 {
        margin-top: 0 !important;
        margin-left: auto !important;
        flex-shrink: 0 !important;
    }

    /* ÍCONES DE ATIVIDADE em mobile */
    html body.format-tiles li[class*="modtype_"] .activity-icon {
        width: 38px !important;
        height: 38px !important;
        min-width: 38px !important;
        min-height: 38px !important;
    }

    html body.format-tiles li[class*="modtype_"] .activity-icon::before {
        width: 18px !important;
        height: 18px !important;
    }

    /* TÍTULO DO CURSO em mobile */
    html body.path-course .page-header-headings h1,
    html body[class*="format-"] .page-header-headings h1 {
        font-size: 18px !important;
        margin: 16px auto !important;
        padding: 4px 0 4px 12px !important;
        border-left-width: 3px !important;
    }

    /* FORMAT TILES - Esconde seções fantasma */
    html body.format-tiles section[id^="section-"]:not(.state-visible) {
        display: none !important;
        height: 0 !important;
        overflow: hidden !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    html body.format-tiles div#format-tiles-multi-section-page {
        min-height: 0 !important;
        margin-bottom: 0 !important;
        padding-bottom: 16px !important;
    }

    /* FORMAT TILES - elimina spacers em mobile */
    html body.format-tiles ul#multi_section_tiles > li.tile.spacer,
    html body.format-tiles ul.tiles > li.tile.spacer,
    html body.format-tiles li.tile.spacer[aria-hidden="true"] {
        display: none !important;
        height: 0 !important;
        width: 0 !important;
        min-width: 0 !important;
        min-height: 0 !important;
        max-width: 0 !important;
        max-height: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
        flex: 0 0 0 !important;
        flex-basis: 0 !important;
        visibility: hidden !important;
        position: absolute !important;
        opacity: 0 !important;
        pointer-events: none !important;
    }

    html body.format-tiles ul#multi_section_tiles > li#lasttitle,
    html body.format-tiles li#lasttitle.tile.spacer {
        display: none !important;
        height: 0 !important;
        width: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
        flex: 0 0 0 !important;
        position: absolute !important;
    }

    html body.format-tiles ul#multi_section_tiles.tiles {
        min-height: 0 !important;
        height: auto !important;
    }


/* ============================================================
   🎨 PALETA DE CORES — Identidade Visual Uniguaçu
   ALTERE OS VALORES AQUI E O CSS INTEIRO REFLETE AUTOMATICAMENTE
   ============================================================ */

:root {
    /* ===== CORES INSTITUCIONAIS ===== */
    --uni-azul:                  #1e3a8a;   /* azul institucional principal */
    --uni-azul-escuro:           #1a4d8c;   /* variação escura (links em avisos) */
    --uni-azul-mais-escuro:      #143a6b;   /* hover dos links */
    --uni-dourado:               #c9a961;   /* dourado institucional */
    --uni-dourado-texto:         #8a6d2a;   /* dourado escuro pra texto sobre fundo claro */
    --uni-dourado-bg:            rgba(201, 169, 97, 0.15);  /* fundo das tags douradas */

    /* ===== TEXTO ===== */
    --texto-principal:           #18181b;   /* títulos, texto principal */
    --texto-secundario:          #1f2937;   /* breadcrumb, modal */
    --texto-terciario:           #374151;   /* cinza médio escuro */
    --texto-suave:               #6b7280;   /* textos auxiliares */
    --texto-mais-suave:          #71717a;   /* descrições */
    --texto-bem-suave:           #9ca3af;   /* separadores breadcrumb */
    --texto-titulo-curso:        #1a1a1a;   /* preto do título do curso */

    /* ===== BORDAS ===== */
    --borda-padrao:              #e4e4e7;
    --borda-hover:               #d4d4d8;
    --borda-divisoria-suave:     #f4f4f5;
    --borda-suave:               #dde3ec;
    --borda-titulo-curso:        #cccccc;

    /* ===== FUNDOS ===== */
    --fundo-branco:              #ffffff;
    --fundo-card-suave:          #fafafa;
    --fundo-hover-cinza:         #f8fafc;

    /* ===== STATUS / SEMÂNTICA ===== */
    --verde-sucesso:             #10b981;   /* check de conclusão */
    --verde-sucesso-escuro:      #059669;   /* hover do check */
    --verde-fundo-suave:         #f0fdf4;
    --vermelho-pendente:         #f87171;
    --amarelo-progresso:         #fbbf24;
    --cinza-futuro:              #cbd5e1;

    /* ===== AVISOS (Plugin Advanced Notifications) ===== */
    --aviso-info-bg:             #fdf6e3;
    --aviso-info-texto:          #6b5520;
    --aviso-info-borda:          #f0e4b8;
    --aviso-success-bg:          #f0f9f4;
    --aviso-success-texto:       #1e6b3f;
    --aviso-success-borda:       #c8e6d3;
    --aviso-success-borda-lat:   #2e8556;
    --aviso-warning-bg:          #fff8e6;
    --aviso-warning-texto:       #8a5a00;
    --aviso-warning-borda:       #f5d99c;
    --aviso-warning-borda-lat:   #d68f00;
    --aviso-danger-bg:           #fdecea;
    --aviso-danger-texto:        #8b1d1d;
    --aviso-danger-borda:        #f5c2c2;
    --aviso-danger-borda-lat:    #c0392b;

    /* ===== ÍCONES DE ATIVIDADES — categorias ===== */
    --icone-conteudo-bg:         #f8fafc;
    --icone-conteudo-cor:        #475569;
    --icone-midia-bg:            #fef5f1;
    --icone-midia-cor:           #D85A30;
    --icone-comunicacao-bg:      #eff6ff;
    --icone-comunicacao-cor:     #378ADD;
    --icone-avaliacao-bg:        #fffbeb;
    --icone-avaliacao-cor:       #b45309;
    --icone-progresso-bg:        #f0fdf4;
    --icone-progresso-cor:       #15803d;
    --icone-referencia-bg:       #f5f3ff;
    --icone-referencia-cor:      #6d28d9;

    /* ===== "AGORA" pill (Completion Progress) ===== */
    --agora-bg:                  #FCEBEB;
    --agora-texto:               #791F1F;

    /* ===== SCROLLBAR (Gradebook) ===== */
    --scroll-track:              #f1f5f9;
    --scroll-thumb:              #94a3b8;
    --scroll-thumb-hover:        #64748b;
    --scroll-thumb-active:       #475569;

    /* ===== TIPOGRAFIA ===== */
    --fonte-principal:           'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
}


/* ============================================
   COMPENSAÇÃO MANUAL DA SEÇÃO ZERO
   ============================================ */

html body.format-tiles #section-zero-container,
html body.format-tiles .section-zero-container {
    padding-left: 55px !important;
    padding-right: 20px !important;
    box-sizing: border-box !important;
}

html body.format-tiles #section-zero-container .row,
html body.format-tiles .section-zero-container .row {
    position: relative !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
}

html body.format-tiles #section-zero-container .row > div.col-sm-11,
html body.format-tiles .section-zero-container .row > div.col-sm-11 {
    flex: 0 0 100% !important;
    max-width: 100% !important;
    width: 100% !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
}

html body.format-tiles #section-zero-container .row > div.col-sm-1.d-none.d-sm-block,
html body.format-tiles .section-zero-container .row > div.col-sm-1 {
    position: absolute !important;
    top: 0 !important;
    right: 0 !important;
    width: auto !important;
    max-width: none !important;
    flex: 0 0 auto !important;
    padding: 0 !important;
    z-index: 5 !important;
}

html body.format-tiles #section-zero-container,
html body.format-tiles #section-0,

        width: 18px !important;
        height: 18px !important;
        max-width: 18px !important;
        max-height: 18px !important;
    }
}
/* ============================================
   ALINHAMENTO LATERAL UNIFORME — cards HTML em mobile
   Iguala largura de qualquer conteúdo HTML (jornada,
   clinic day, futuros cards) com as seções do curso
   ============================================ */

@media (max-width: 768px) {
    /* Remove padding lateral dos wrappers de rótulo (mod_label)
       quando contêm cards grid de 2 colunas (jornada, clinic day, etc.) */
    html body[class*="format-"] li.modtype_label,
    html body[class*="format-"] li.modtype_label > div,
    html body[class*="format-"] li.modtype_label .activity,
    html body[class*="format-"] li.modtype_label .activity-wrapper,
    html body[class*="format-"] li.modtype_label .activity-instance,
    html body[class*="format-"] li.modtype_label .contentwithoutlink,
    html body[class*="format-"] li.modtype_label .mod-indent-outer,
    html body[class*="format-"] li.modtype_label .mod-indent {
        padding-left: 0 !important;
        padding-right: 0 !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
    }

    /* Garante que o card grid ocupe 100% do espaço disponível */
    html body[class*="format-"] div[style*="display: grid"][style*="grid-template-columns"] {
        width: 100% !important;
        max-width: 100% !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
        box-sizing: border-box !important;
    }
}

@media (max-width: 480px) {
    /* Sobrescreve a regra geral de .activity {padding: 12px} em mobile pequeno
       APENAS para rótulos com cards HTML */
    html body.format-tiles li.modtype_label .activity {
        padding: 12px 0 !important;
    }
}

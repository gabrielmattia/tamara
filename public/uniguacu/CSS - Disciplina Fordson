html body[class*="format-tiles"] #format-tiles-multi-section-page {
    max-width: 1100px !important;
    width: 100% !important;
    margin-left: auto !important;
    margin-right: auto !important;
    text-align: center !important;
}

html body.format-tiles ul.tiles,
html body.format-tiles ul#multi_section_tiles,
html body[class*="format-tiles"] ul.multi_section_tiles {
    display: flex !important;
    flex-wrap: wrap !important;
    justify-content: center !important;
    align-items: stretch !important;
    margin-left: auto !important;
    margin-right: auto !important;
    padding: 0 !important;
    list-style: none !important;
    text-align: center !important;
    gap: 14px !important;
    max-width: 100% !important;
    width: 100% !important;
}

html body.format-tiles ul.tiles > li.tile,
html body.format-tiles ul#multi_section_tiles > li.tile,
html body[class*="format-tiles"] ul.multi_section_tiles > li.tile {
    flex: 0 0 234px !important;
    width: 234px !important;
    min-width: 234px !important;
    max-width: 234px !important;
    margin: 0 !important;
}

html body.format-tiles ul.tiles > li.section,
html body.format-tiles ul#multi_section_tiles > li.section {
    max-width: 100% !important;
}

html body.format-tiles ul.multi_section_tiles > li.tile-spacer[aria-hidden="true"],
html body.format-tiles ul.multi_section_tiles > li.lasttile,
html body.format-tiles ul.multi_section_tiles > li[style*="display: none"],
html body.format-tiles ul.multi_section_tiles > li.section[style*="display: none"] {
    display: none !important;
}

@media (max-width: 768px) {
    html body.format-tiles div#format-tiles-multi-section-page {
        max-width: 100% !important;
    }
    html body.format-tiles ul.tiles > li.tile,
    html body.format-tiles ul#multi_section_tiles > li.tile {
        flex: 0 0 180px !important;
        width: 180px !important;
        min-width: 180px !important;
        max-width: 180px !important;
    }
    html body[class*="format-"] #region-main,
    html body[class*="format-"] #region-main-box,
    html body[class*="format-"] .course-content {
        padding-left: 12px !important;
        padding-right: 12px !important;
        box-sizing: border-box !important;
    }

    html body[class*="format-"] #page-content,
    html body[class*="format-"] .container-fluid {
        padding-left: 0 !important;
        padding-right: 0 !important;
    }
}

@media (max-width: 480px) {
    html body.format-tiles ul.tiles > li.tile,
    html body.format-tiles ul#multi_section_tiles > li.tile {
        flex: 0 0 100% !important;
        width: 100% !important;
        max-width: 100% !important;
    }
}



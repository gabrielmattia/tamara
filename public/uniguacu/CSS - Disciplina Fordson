/* ============================================
   STATUS DA ATIVIDADE - Ícone circular unificado
   ============================================ */

html body .activity-information,
html body [data-region="activity-information"] {
    margin: 0 !important;
    padding: 0 !important;
}

html body .automatic-completion-conditions,
html body [data-region="completionrequirements"],
html body [data-region="completion-info"] {
    margin: 0 !important;
    padding: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: flex-end !important;
    gap: 0 !important;
}

/* Esconde texto interno dos botões manuais */
html body button.btn[data-action="toggle-manual-completion"] {
    font-size: 0 !important;
    color: transparent !important;
    line-height: 0 !important;
    overflow: hidden !important;
    white-space: nowrap !important;
    text-indent: -9999px !important;
}

html body button.btn[data-action="toggle-manual-completion"] i.fa,
html body button.btn[data-action="toggle-manual-completion"] i.fa-check {
    display: none !important;
}

/* ESTADO PENDENTE - Círculo vazio cinza */
html body .badge.badge-pill.badge-light,
html body button.btn.btn-outline-secondary[data-action="toggle-manual-completion"][data-toggletype="manual:mark-done"] {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 28px !important;
    height: 28px !important;
    min-width: 28px !important;
    min-height: 28px !important;
    padding: 0 !important;
    background: transparent !important;
    border: 1.5px solid var(--cinza-futuro) !important;
    border-radius: 50% !important;
    font-size: 0 !important;
    line-height: 0 !important;
    color: transparent !important;
    box-shadow: none !important;
    transition: all 0.2s ease !important;
    position: relative !important;
    text-indent: 0 !important;
}

html body button.btn.btn-outline-secondary[data-action="toggle-manual-completion"]:hover {
    border-color: var(--verde-sucesso) !important;
    background: var(--verde-fundo-suave) !important;
    cursor: pointer !important;
}

html body .badge.badge-pill.badge-light:hover {
    border-color: var(--scroll-thumb) !important;
    background: var(--fundo-hover-cinza) !important;
}

/* Preview do check ao passar o mouse no botão manual */
html body button.btn.btn-outline-secondary[data-action="toggle-manual-completion"]:hover::before {
    content: "" !important;
    width: 16px !important;
    height: 16px !important;
    background-color: var(--verde-sucesso) !important;
    -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><polyline points='20 6 9 17 4 12'/></svg>") no-repeat center / contain !important;
    mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><polyline points='20 6 9 17 4 12'/></svg>") no-repeat center / contain !important;
    display: block !important;
    opacity: 0.4 !important;
}

/* ESTADO CONCLUÍDO - Círculo verde com check */
html body .badge.badge-pill.alert-success,
html body button.btn.btn-success[data-action="toggle-manual-completion"][data-toggletype="manual:undo"] {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 28px !important;
    height: 28px !important;
    min-width: 28px !important;
    min-height: 28px !important;
    padding: 0 !important;
    background: var(--verde-sucesso) !important;
    border: 1.5px solid var(--verde-sucesso) !important;
    border-radius: 50% !important;
    font-size: 0 !important;
    line-height: 0 !important;
    color: transparent !important;
    box-shadow: none !important;
    position: relative !important;
    text-indent: 0 !important;
    transition: all 0.2s ease !important;
}

html body .badge.badge-pill.alert-success::before,
html body button.btn.btn-success[data-action="toggle-manual-completion"]::before {
    content: "" !important;
    width: 16px !important;

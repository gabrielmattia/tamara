<div id="carouselBanners" class="carousel slide" data-ride="carousel" data-interval="5000" data-pause="hover">

    <!-- Indicadores (bolinhas) -->
    <ol class="carousel-indicators">
        <li data-target="#carouselBanners" data-slide-to="0" class="active"></li>
        <li data-target="#carouselBanners" data-slide-to="1"></li>
        <li data-target="#carouselBanners" data-slide-to="2"></li>
    </ol>

    <!-- Slides -->
    <div class="carousel-inner">

        <!-- ===== SLIDE 1 ===== -->
        <div class="carousel-item active">
            <a href="https://uniguacu.com.br/" target="_blank" rel="noopener" class="banner-link">
                <img src="LINK DA IMAGEM" class="d-block w-100" alt="Banner 1">
            </a>
        </div>

        <!-- ===== SLIDE 2 ===== -->
        <div class="carousel-item">
            <a href="https://uniguacu.com.br/" target="_blank" rel="noopener" class="banner-link">
                <img src="LINK DA IMAGEM" class="d-block w-100" alt="Banner 2">
            </a>
        </div>

        <!-- ===== SLIDE 3 ===== -->
        <div class="carousel-item">
            <a href="https://uniguacu.com.br/" target="_blank" rel="noopener" class="banner-link">
                <img src="LINK DA IMAGEM" class="d-block w-100" alt="Banner 3">
            </a>
        </div>

    </div>

    <!-- Setas -->
    <a class="carousel-control-prev" href="#carouselBanners" role="button" data-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="sr-only">Anterior</span>
    </a>
    <a class="carousel-control-next" href="#carouselBanners" role="button" data-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="sr-only">Próximo</span>
    </a>

</div>
